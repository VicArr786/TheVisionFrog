# compressed web video used by /Commercials/NyuV100 — keep despite *.mp4 rule
!assets/images/Commercial/NYU?V100?TRAILER/v100_trailer_web.mp4

# web-sized loops made by scripts/optimize-media.mjs (GIF -> mp4)
!assets/images/**/web/*.mp4

# 8s background loops for the Music Videos player
!assets/videos/music-videos/*.mp4

# web copies of the home tile thumbnails (sources in assets/videos/Thumbnails stay local)
!assets/videos/home/*.mp4

# campaign videos played on the site — keep each under 25 MiB (Cloudflare Pages file limit)
!assets/videos/Campaigns/*.mp4
